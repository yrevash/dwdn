# ─── Instagram (the dummy account that RECEIVES the reels) ───
IG_USERNAME=your_dummy_username
IG_PASSWORD=your_dummy_password
# 2FA: paste your AUTHENTICATOR-APP secret key here so the bot generates its own
# codes (required for headless re-login). Instagram → Settings → Security →
# Two-factor authentication → Authentication app → copy the "key" / setup key.
IG_TOTP_SEED=
# IG_2FA_CODE=        # optional: one-time 6-digit code for a first manual login
DM_ENABLED=true       # false = Apify-only (the IG account is never logged into / used)

# ─── Cloudflare R2 — SCOPED token for granthvani-reels-inbox ONLY ───
# This token must NOT be your main R2 key. It is scoped to the inbox bucket
# only and physically cannot touch granthvani-cdn.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=token_access_key_id
R2_SECRET_ACCESS_KEY=token_secret_access_key
R2_BUCKET=granthvani-reels-inbox
R2_PREFIX=reels/

# ─── HEVC transcode (visually transparent compression) ───
TRANSCODE=true
TRANSCODE_CRF=28           # quality/size dial: lower=bigger/better, higher=smaller. 28 ≈ great on phones
TRANSCODE_PRESET=slow      # best compression efficiency (you don't care about speed)

# ─── Runtime ───
DOWNLOAD_DIR=./downloads
POLL_INTERVAL=30
MAX_WORKERS=3
DOWNLOAD_MIN_GAP=8          # min seconds between download STARTS (anti-flag throttle; raise to go slower)
# IG_PROXY=http://user:pass@host:port   # optional; STRONGLY recommended for big backfills

# ─── Scraping via Apify (off-account — Apify scrapes IG, we download CDN URLs) ───
# Target accounts live in targets.txt (one @username per line), NOT here.
APIFY_ENABLED=true
APIFY_TOKEN=                    # apify.com → Settings → Integrations → API token
APIFY_ACTOR=xMc5Ga1oCONPmWJIa  # Instagram Reel Scraper
APIFY_BACKFILL_LIMIT=1000      # reels/account on the FIRST run — one-time cost ≈ (accounts × this) × $2.60/1000
APIFY_ONGOING_LIMIT=50         # reels/account on later runs (only genuinely-NEW reels are billed)
APIFY_INTERVAL=21600           # seconds between Apify runs (21600 = 6h)

# (The old on-account instagrapi scraper SCRAPE_* settings are no longer used —
#  scraping now runs through Apify so the account is never used for it.)
SCRAPE_ENABLED=false

# ─── YouTube channel → R2 mirror (yt_watcher.py — a SEPARATE always-on service) ───
# Mirrors a channel you have PERMISSION to redistribute. Uploads under YT_PREFIX
# so it never collides with the reels. Dedup by video id (youtube_done.json).
YT_CHANNEL=                # e.g. https://www.youtube.com/@ChannelHandle  (or /videos URL)
YT_VIEW_MIN=500            # only mirror videos with at least this many views
YT_PREFIX=youtube/         # R2 key prefix for YouTube videos (reels use reels/)
YT_TRANSCODE=true          # HEVC-compress before upload (recommended for long videos); false = raw
YT_INTERVAL=43200          # seconds between channel sweeps (43200 = 12h)
# YT_FORMAT=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best   # optional override
# YTDLP_BIN=               # optional: full path to yt-dlp (auto-detected from the venv otherwise)
